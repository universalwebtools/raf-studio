rules_version = '2';

// Zapis tylko dla konta admina strony (rafal.kukla00@gmail.com).
service firebase.storage {
  match /b/{bucket}/o {
    match /website/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'HAiGZhbpGShsvxJFJ0QlDmvaryG2';
    }
  }
}
